{
  "expo": {
    "name": "Ugnay",
    "slug": "ugnay",
    "scheme": "ugnay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ugnay.coop.mobile",
      "permissions": ["CAMERA"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Ugnay to access the camera for facial registration and identity verification."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Ugnay to access your photos for profile verification."
        }
      ]
    ]
  }
}
